# OpenRustClaw Docker Environment Configuration
# Copy this file to .env and fill in your values for Docker deployment

# === Core Settings ===
RUST_LOG=info
APP_ENV=production

# === LLM Provider API Keys (at least one required) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# === Ollama (optional - for local models) ===
OLLAMA_BASE_URL=http://host.docker.internal:11434

# === LangSmith Observability (optional) ===
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=openrustclaw
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# === Gateway Configuration ===
GATEWAY_PORT=18789
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === Security (CHANGE THESE IN PRODUCTION!) ===
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-secret-minimum-32-characters-long
SKILL_SIGNING_KEY=

# === Scheduler ===
SCHEDULER_POLL_INTERVAL_MS=1000
SCHEDULER_LEASE_DURATION_SECS=60

# === Sidecar ===
SIDECAR_GRPC_PORT=50051

# === Optional Volume Paths ===
# CONFIG_PATH=./config
# SKILLS_PATH=./skills
# LOGS_PATH=./logs

# === Development Only ===
LOG_LEVEL=INFO
DB_UI_PASSWORD=admin
GRAFANA_PASSWORD=admin
