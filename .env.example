# OpenRustClaw Environment Configuration
# Copy this file to .env and fill in your values

# === LLM Provider API Keys ===
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...

# === Ollama (local models) ===
OLLAMA_BASE_URL=http://localhost:11434

# === LangSmith Observability ===
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=openrustclaw
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# === Gateway Configuration ===
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=18789
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === Database ===
DATABASE_URL=sqlite://data/openrustclaw.db
DATABASE_WAL_MODE=true

# === Security ===
AUTH_SECRET=change-me-to-a-random-secret
SKILL_SIGNING_KEY=  # Ed25519 private key (base64)

# === Python Sidecar ===
SIDECAR_GRPC_PORT=50051
SIDECAR_PYTHON_PATH=python3

# === Scheduler ===
SCHEDULER_POLL_INTERVAL_MS=1000
SCHEDULER_LEASE_DURATION_SECS=60
